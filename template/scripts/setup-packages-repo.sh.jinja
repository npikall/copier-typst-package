#!/usr/bin/env bash
set -euo pipefail

FORK_URL="https://github.com/{{ git_user }}/packages"
CLONE_DIR="${HOME}/typst/packages"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
TYPST_TOML="${PROJECT_ROOT}/typst.toml"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

_ok()   { echo -e "${GREEN}✓${NC} $*"; }
_skip() { echo -e "${YELLOW}–${NC} $*"; }
_err()  { echo -e "${RED}✗${NC} $*" >&2; }

if [[ ! -f "$TYPST_TOML" ]]; then
    _err "typst.toml not found at ${TYPST_TOML}"
    exit 1
fi

PACKAGE_NAME=$(awk -F'"' '/^name[[:space:]]*=/{print $2; exit}' "$TYPST_TOML")
if [[ -z "$PACKAGE_NAME" ]]; then
    _err "Could not parse package name from typst.toml"
    exit 1
fi

SPARSE_PATH="packages/preview/${PACKAGE_NAME}"

if [[ -d "${CLONE_DIR}/.git" ]]; then
    _skip "${CLONE_DIR} already cloned"
    git -C "$CLONE_DIR" sparse-checkout add "$SPARSE_PATH"
    _ok "Added ${SPARSE_PATH} to sparse checkout"
else
    mkdir -p "$(dirname "$CLONE_DIR")"
    git clone --filter=blob:none --sparse "$FORK_URL" "$CLONE_DIR"
    git -C "$CLONE_DIR" sparse-checkout set "$SPARSE_PATH"
    _ok "Cloned ${FORK_URL} to ${CLONE_DIR}"
    _ok "Sparse checkout: ${SPARSE_PATH}"
fi

echo ""
_ok "Done. Use GOTPM_INSTALL_DIR=${CLONE_DIR} to publish directly to your fork."
